# Supabase Connection
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Cloudflare R2 (storage gambar — egress $0)
# Buat API token R2: Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=menu-assets
# Custom domain yang terhubung ke bucket (harus lewat Cloudflare), contoh:
# CATATAN: jangan pakai domain *.r2.dev untuk produksi — sering diblokir DNS ISP
# di Indonesia. Selama masih *.r2.dev, gambar otomatis disajikan lewat
# proxy internal /media/<key> (lihat lib/imageUrl.ts & app/media/[...key]).
NEXT_PUBLIC_R2_PUBLIC_URL=https://img.ratey.site

# Google Places API Key
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# Base URL Aplikasi
NEXT_PUBLIC_BASE_URL=https://ratey.site

# Master Secret Key Admin Dashboard
ADMIN_SECRET_KEY=your-admin-master-password-here
